# ---------------------------------------------------------------------------
# Copy this file to `.env` before running `docker compose up`.
#   cp .env.example .env
# `.env` is gitignored; no real credential is ever committed to this repo.
# ---------------------------------------------------------------------------

# --- Postgres container ----------------------------------------------------
POSTGRES_USER=celesnity
POSTGRES_PASSWORD=celesnity_local_dev
# Mapped away from 5432 so the stack never collides with a PostgreSQL already
# installed on the reviewer's machine.
POSTGRES_PORT=5433

# --- Platform database (this application's own persistence) ----------------
DATABASE_URL=postgresql://celesnity:celesnity_local_dev@localhost:5433/platform?schema=public

# --- API -------------------------------------------------------------------
API_PORT=4000
# Encryption key for secrets supplied through the masked input in the UI.
# 32 bytes, hex-encoded. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Batch data is considered stale after this many minutes without a new event.
STALE_THRESHOLD_MINUTES=15
# A station quantity deviating from the received quantity by more than this
# fraction raises a QUANTITY_MISMATCH quality indicator.
QUANTITY_TOLERANCE=0.05

# Seeded organization and actor (full auth/user management is out of scope).
SEED_ORGANIZATION_ID=org-celesnity-laundry
SEED_ORGANIZATION_NAME=Celesnity Industrial Laundry
SEED_ACTOR=line.manager@celesnity.local

# --- Production database source (the factory's own database) ---------------
# Referenced by name from the registered source; the value is read at connect
# time and never stored in the platform database or returned by the API.
PRODUCTION_DB_PASSWORD=factory_local_dev

# --- Fixture services ------------------------------------------------------
APP_API_PORT=4001
SUPPLIER_PORTAL_PORT=4002

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- MQTT (optional, disabled by default) ----------------------------------
# Enable with: docker compose --profile mqtt up
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://localhost:1883
